#!/bin/sh
#
# Generated by Gradle.  Runs the Gradle wrapper from a Unix shell.
# (Android Studio keeps this file; it is committed for people who build from a terminal.)
#

if [ -z "$JAVA_HOME" ]; then
  javaExecutable=java
else
  javaExecutable="$JAVA_HOME/bin/java"
fi

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$SCRIPT_DIR/gradle-wrapper.jar"

exec "$javaExecutable" -Dfile.encoding=UTF-8 -jar "$WRAPPER_JAR" "$@"

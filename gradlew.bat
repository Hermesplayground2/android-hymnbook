@rem
@rem Generated by Gradle.
@rem
@rem This file is only needed to run the Gradle wrapper from a Windows CMD prompt.
@rem
@echo off

set DIRNAME=%~dp0
if "%DIRNAME%" == "" set DIRNAME=.
set APP_BASE_NAME=%~n0
set WRAPPER_JAR="%DIRNAME%gradle-wrapper.jar"
set WRAPPER_LAUNCHER=org.gradle.wrapper.GradleWrapperMain

set CLASSPATH=%WRAPPER_JAR%

if "%JAVA_HOME%" == "" goto execute

set JAVA_EXE=%JAVA_HOME%\bin\java
if not exist "%JAVA_EXE%" goto execute

goto endInit

:execute
@rem Setup the command line
set CLASSPATH=%WRAPPER_JAR%

:endInit
@rem Execute Gradle
"%JAVA_EXE%" %DEFAULT_JVM_OPTS% %JAVA_OPTS% %GRADLE_OPTS% -classpath "%CLASSPATH%" %WRAPPER_LAUNCHER% %*

:end
@rem End local scope for the variables with windows NT shell
if "%ERRORLEVEL%"=="0" goto mainEnd

:mainEnd
@rem No special handling needed
